digraph method {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.45", fontname="DejaVu Sans", splines=spline, dpi=200, newrank=true, compound=true];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, penwidth=1.1, margin="0.2,0.11", color="#94a3b8", fillcolor="white"];
  edge  [color="#475569", penwidth=1.3, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10, fontcolor="#475569"];

  subgraph cluster_human {
    label=<<b>1 · Human data</b><br/><font point-size="10" color="#475569">three 40 s RGB-D takes, one fixed camera, no markers</font>>; labeljust=l; fontname="DejaVu Sans"; fontsize=13;
    style="rounded,filled"; fillcolor="#eff6ff"; color="#bfdbfe"; margin=16;
    H [label=<<b>Takes</b><br/><font point-size="10">RGB-D video of me doing the task</font>>];
    K [label=<<b>Per-frame extraction</b><br/><font point-size="10">door angle · pot pick / place · hand path<br/>camera registered to the twin</font>>];
    C [label=<<b>Keyframes</b><br/><font point-size="10">what the objects did, not how the hand moved</font>>];
    H -> K -> C;
  }

  subgraph cluster_twin {
    label=<<b>2 · Digital twin</b><br/><font point-size="10" color="#475569">measured geometry, scanned appearance</font>>; labeljust=l; fontname="DejaVu Sans"; fontsize=13;
    style="rounded,filled"; fillcolor="#f0fdf4"; color="#bbf7d0"; margin=16;
    M [label=<<b>Measurements</b><br/><font point-size="10">tape, calipers → URDF</font>>];
    S [label=<<b>Scans</b><br/><font point-size="10">RealSense sweeps → Pi3X poses + fused depth</font>>];
    T [label=<<b>Assets</b><br/><font point-size="10">microwave + pot, colours baked, registered to 2 mm</font>>];
    M -> T; S -> T;
  }

  subgraph cluster_sim {
    label=<<b>3 · Simulation and learning</b><br/><font point-size="10" color="#475569">ManiSkill3 / SAPIEN · PhysX CPU · 20 Hz joint control</font>>; labeljust=l; fontname="DejaVu Sans"; fontsize=13;
    style="rounded,filled"; fillcolor="#fffbeb"; color="#fde68a"; margin=16;
    Q [label=<<b>Solver</b><br/><font point-size="10">IK along Cartesian paths, executed in physics</font>>];
    D [label=<<b>Demonstrations</b><br/><font point-size="10">96 starts · DART noise · cameras at the real pose</font>>];
    R [label=<<b>Randomised renders</b><br/><font point-size="10">two random scenes per demo (DoorMan-style)</font>>];
    N [label=<<b>Camera policy</b><br/><font point-size="10">ResNet-18 + DiT · action chunks · front + wrist images, joints</font>>];
    Q -> D -> R -> N;
  }

  subgraph cluster_eval {
    label=<<b>4 · Evaluation</b><br/><font point-size="10" color="#475569">128 unseen starts, paired tests · the room is never a training scene</font>>; labeljust=l; fontname="DejaVu Sans"; fontsize=13;
    style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; margin=16;
    G [label=<<b>Gaussian splat of the room</b><br/><font point-size="10">300 sweep frames · microwave painted out<br/>rendered behind both cameras, evaluation only</font>>];
    E [label=<<b>Success</b><br/><font point-size="10">grey floor <b>74 %</b> · splatted room <b>68 %</b></font>>, color="#475569", penwidth=1.5];
    { rank=same; G; E; }
    G -> E [label=" background"];
  }

  subgraph cluster_g1 {
    label=<<b>Side branch</b><br/><font point-size="10" color="#475569">scripted, not evaluated</font>>; labeljust=l; fontname="DejaVu Sans"; fontsize=12;
    style="rounded,dashed"; color="#94a3b8"; margin=14;
    U [label=<<b>Unitree G1 upper body</b><br/><font point-size="10">the same keyframes, hand-scripted IK<br/>one run · no policy · no success rate</font>>, style="rounded,filled,dashed"];
  }

  C -> Q [label=" constraints"];
  T -> Q [label=" scene"];
  S -> G [style=dashed, label=" room sweep", constraint=false];
  N -> E [label=" rollouts"];
  C -> U [style=dashed, label=" same keyframes"];
}
